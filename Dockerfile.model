# Dockerfile.model
FROM python:3.11-slim

WORKDIR /app

# System deps for building wheels
RUN apt-get update && apt-get install -y build-essential && rm -rf /var/lib/apt/lists/*

# Copy model service + model files
COPY model_service.py ./model_service.py
COPY export ./export

# Install Python deps
RUN pip install --no-cache-dir \
    "tensorflow-cpu==2.16.1" \
    fastapi \
    "uvicorn[standard]" \
    pillow \
    python-multipart

# Render will pass $PORT; fall back to 8001 for local runs
ENV PORT=8001

EXPOSE 8001

CMD ["sh", "-c", "uvicorn model_service:app --host 0.0.0.0 --port ${PORT}"]
